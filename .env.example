# Copy this to .env and fill in your keys
# cp .env.example .env

# Alpha Vantage — for fetching fundamentals (income, balance, cashflow, overview)
# Get a free key at https://www.alphavantage.co/support/#api-key
# Premium key recommended for parallel analysis (75+ tickers simultaneously)
AV_API_KEY=your_alpha_vantage_key_here

# Massive API — for live news events, short interest, capital raises
# Contact massive.com for API access
MASSIVE_API_KEY=your_massive_api_key_here
